# ==============================================================
# CampusHire - Environment Variables Template (.env.example)
# ==============================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. MongoDB Database Connection (MongoDB Atlas or MongoDB Compass)
# For MongoDB Atlas (Free Tier M0 Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campushire?retryWrites=true&w=majority
# For local MongoDB Compass inspection:
MONGODB_URI=mongodb://127.0.0.1:27017/campushire
MONGO_URI=mongodb://127.0.0.1:27017/campushire

# 3. JWT Authentication (BTWA Core System)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# 4. Firebase Authentication & Storage Admin Credentials (Phase 2 & 3)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# 5. Google Gemini AI API Configuration (Phase 4+)
# Obtain a free-tier API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Web Search API (Phase 10 - OPTIONAL)
# Optional public search provider (e.g. Tavily, Serper, or Brave free tiers)
OPTIONAL_SEARCH_API_KEY=
